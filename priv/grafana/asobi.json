  "panels": [
    {"type": "row", "title": "Connections & sessions", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}, "id": 100, "collapsed": false, "panels": []},
    {
      "type": "timeseries", "title": "WS connects / min",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 1}, "id": 1,
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "sum(rate(asobi_ws_connected_total[$__rate_interval])) * 60", "legendFormat": "connected", "refId": "A"},
        {"expr": "sum(rate(asobi_ws_disconnected_total[$__rate_interval])) * 60", "legendFormat": "disconnected", "refId": "B"}
      ]
    },
    {
      "type": "timeseries", "title": "WS messages / min by type",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 1}, "id": 2,
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "sum by (type) (rate(asobi_ws_message_in_total[$__rate_interval])) * 60", "legendFormat": "in: {{type}}", "refId": "A"},
        {"expr": "sum by (type) (rate(asobi_ws_message_out_total[$__rate_interval])) * 60", "legendFormat": "out: {{type}}", "refId": "B"}
      ]
    },
    {
      "type": "timeseries", "title": "Session duration (seconds)",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 1}, "id": 3,
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [
        {"expr": "histogram_quantile(0.5, sum(rate(asobi_session_duration_seconds_bucket[$__rate_interval])) by (le))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum(rate(asobi_session_duration_seconds_bucket[$__rate_interval])) by (le))", "legendFormat": "p95", "refId": "B"}
      ]
    },
